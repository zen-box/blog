# 复制为 .env 后填写

# 你的域名（需已解析到服务器），Caddy 会自动申请 HTTPS 证书
SITE_DOMAIN=blog.example.com

# 可选：登录认证用的密钥。留空时首次启动会自动生成，保存在 data/.auth-secret
BETTER_AUTH_SECRET=

# 可选：创建管理员时需要填写的设置令牌。留空时自动生成并打印在日志里：
#   docker compose logs blog | grep 设置令牌
ADMIN_SETUP_TOKEN=

# 可选：国内服务器构建镜像时使用 npm 镜像源
# NPM_REGISTRY=https://registry.npmmirror.com
